{
  "name": "Nextmove Daily Intelligence & Webhook Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 0 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule (06:00 IST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "nextmove-add-company",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-add-company",
      "name": "Webhook: Add Company",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 500]
    },
    {
      "parameters": {
        "url": "={{ $env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000' }}/api/companies",
        "options": {}
      },
      "id": "get-companies",
      "name": "Fetch Watched Companies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches",
      "name": "Loop Through Companies",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000' }}/api/refresh?id={{ $json.id }}",
        "options": {}
      },
      "id": "trigger-company-refresh",
      "name": "HTTP POST /api/refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXT_PUBLIC_APP_URL || 'http://localhost:3000' }}/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET || 'nextmove_n8n_secret_2026' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "completed"
            },
            {
              "name": "event",
              "value": "daily_intelligence_run"
            }
          ]
        },
        "options": {}
      },
      "id": "callback-nextmove",
      "name": "Callback /api/webhooks/n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Schedule (06:00 IST)": {
      "main": [
        [
          {
            "node": "Fetch Watched Companies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Watched Companies": {
      "main": [
        [
          {
            "node": "Loop Through Companies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Through Companies": {
      "main": [
        [
          {
            "node": "HTTP POST /api/refresh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP POST /api/refresh": {
      "main": [
        [
          {
            "node": "Loop Through Companies",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
